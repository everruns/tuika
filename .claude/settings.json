{
  "gitAttribution": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(doppler me)",
      "Bash(doppler run --only-secrets COMMIT_SIGNING_KEY_B64:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/fix-git-identity.sh"
          }
        ]
      }
    ]
  }
}
