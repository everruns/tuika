+// subcellRects fills a 2-column, rows-row sub-cell grid from mask (bit
+// row*2+col), edge to edge, the way a terminal draws block mosaics.
+func subcellRects(mask uint8, rows int, bounds image.Rectangle) []image.Rectangle {
+	x0, y0 := bounds.Min.X, bounds.Min.Y
+	w, h := bounds.Dx(), bounds.Dy()
+	rects := make([]image.Rectangle, 0, 8)
+	for row := 0; row < rows; row++ {
+		for col := 0; col < 2; col++ {
+			if mask&(1<<(row*2+col)) == 0 {
+				continue
+			}
+			rects = append(rects, image.Rect(
+				x0+w*col/2, y0+h*row/rows,
+				x0+w*(col+1)/2, y0+h*(row+1)/rows,
+			))
+		}
+	}
+	return rects
+}
