+func (b *ghosttyBackend) drawKittyGraphics(target draw.Image) error {
+	graphics, err := b.term.KittyGraphics()
+	if err != nil {
+		return fmt.Errorf("read Ghostty Kitty graphics: %w", err)
+	}
+	iterator, err := libghostty.NewKittyGraphicsPlacementIterator()
+	if err != nil {
+		return fmt.Errorf("create Ghostty Kitty placement iterator: %w", err)
+	}
+	defer iterator.Close()
+	if err := graphics.PlacementIterator(iterator); err != nil {
+		return fmt.Errorf("read Ghostty Kitty placements: %w", err)
+	}
+
+	for iterator.Next() {
+		placement, err := iterator.Info()
+		if err != nil {
+			return fmt.Errorf("read Ghostty Kitty placement: %w", err)
+		}
+		imageHandle := graphics.Image(placement.ImageID)
+		if imageHandle == nil {
+			continue
+		}
+		info, err := imageHandle.Info()
+		if err != nil {
+			return fmt.Errorf("read Ghostty Kitty image: %w", err)
+		}
+		geometry, err := iterator.RenderInfo(imageHandle, b.term)
+		if err != nil {
+			return fmt.Errorf("resolve Ghostty Kitty placement: %w", err)
+		}
+		if !geometry.ViewportVisible || info.Format != libghostty.KittyImageFormatRGBA ||
+			info.Compression != libghostty.KittyImageCompressionNone {
+			continue
+		}
+		expected := int(info.Width) * int(info.Height) * 4
+		if len(info.Data) < expected {
+			continue
+		}
+		source := &image.RGBA{
+			Pix:    info.Data[:expected],
+			Stride: int(info.Width) * 4,
+			Rect:   image.Rect(0, 0, int(info.Width), int(info.Height)),
+		}
+		sourceRect := image.Rect(
+			int(geometry.SourceX),
+			int(geometry.SourceY),
+			int(geometry.SourceX+geometry.SourceWidth),
+			int(geometry.SourceY+geometry.SourceHeight),
+		)
+		left := int(geometry.ViewportCol)*b.cellWidth + int(placement.XOffset)
+		top := int(geometry.ViewportRow)*b.cellHeight + int(placement.YOffset)
+		destination := image.Rect(
+			left,
+			top,
+			left+int(geometry.PixelWidth),
+			top+int(geometry.PixelHeight),
+		)
+		xdraw.ApproxBiLinear.Scale(target, destination, source, sourceRect, draw.Over, nil)
+	}
+	return nil
+}
+
+// kittyPlaceholder is the Kitty graphics protocol's Unicode placeholder: a
+// cell holding it shows one cell-sized fragment of an image whose id is the
+// cell's foreground color, at the row and column its diacritics name.
+const kittyPlaceholder = '\U0010EEEE'
+
+// withoutKittyPlaceholders blanks placeholder cells so their glyph is not
+// drawn as text; drawKittyPlaceholders paints the image fragment instead.
+func withoutKittyPlaceholders(cells []renderedCell) []renderedCell {
+	out := cells
+	for i, cell := range cells {
+		if strings.HasPrefix(cell.text, string(kittyPlaceholder)) {
+			if &out[0] == &cells[0] {
+				out = append([]renderedCell(nil), cells...)
+			}
+			out[i].text = " "
+		}
+	}
+	return out
+}
+
+// drawKittyPlaceholders paints Unicode-placeholder cells, which the placement
+// iterator reports only as virtual placements without screen geometry. Each
+// cell names its image (foreground color), and its row and column in the
+// virtual placement's grid (first two diacritics). The image is fit into that
+// grid preserving aspect ratio and centered, as Ghostty's own renderer does.
+func (b *ghosttyBackend) drawKittyPlaceholders(target *image.RGBA, cells [][]renderedCell) error {
+	graphics, err := b.term.KittyGraphics()
+	if err != nil {
+		return fmt.Errorf("read Ghostty Kitty graphics: %w", err)
+	}
+	iterator, err := libghostty.NewKittyGraphicsPlacementIterator()
+	if err != nil {
+		return fmt.Errorf("create Ghostty Kitty placement iterator: %w", err)
+	}
+	defer iterator.Close()
+	if err := graphics.PlacementIterator(iterator); err != nil {
+		return fmt.Errorf("read Ghostty Kitty placements: %w", err)
+	}
+	type grid struct{ cols, rows int }
+	grids := map[uint32]grid{}
+	for iterator.Next() {
+		virtual, err := iterator.IsVirtual()
+		if err != nil || !virtual {
+			continue
+		}
+		id, err := iterator.ImageID()
+		if err != nil {
+			continue
+		}
+		cols, err := iterator.Columns()
+		if err != nil {
+			continue
+		}
+		rows, err := iterator.Rows()
+		if err != nil {
+			continue
+		}
+		grids[id] = grid{int(cols), int(rows)}
+	}
+	if len(grids) == 0 {
+		return nil
+	}
+
+	cw, ch := float64(b.cellWidth), float64(b.cellHeight)
+	for y, row := range cells {
+		for x, cell := range row {
+			runes := []rune(cell.text)
+			if len(runes) < 3 || runes[0] != kittyPlaceholder {
+				continue
+			}
+			r, c := kittyDiacriticIndex(runes[1]), kittyDiacriticIndex(runes[2])
+			fg := cell.foreground
+			id := uint32(fg.R)<<16 | uint32(fg.G)<<8 | uint32(fg.B)
+			g, ok := grids[id]
+			if r < 0 || c < 0 || !ok || g.cols == 0 || g.rows == 0 {
+				continue
+			}
+			handle := graphics.Image(id)
+			if handle == nil {
+				continue
+			}
+			info, err := handle.Info()
+			if err != nil {
+				return fmt.Errorf("read Ghostty Kitty image: %w", err)
+			}
+			expected := int(info.Width) * int(info.Height) * 4
+			if info.Format != libghostty.KittyImageFormatRGBA ||
+				info.Compression != libghostty.KittyImageCompressionNone ||
+				len(info.Data) < expected || info.Width == 0 || info.Height == 0 {
+				continue
+			}
+			source := &image.RGBA{
+				Pix:    info.Data[:expected],
+				Stride: int(info.Width) * 4,
+				Rect:   image.Rect(0, 0, int(info.Width), int(info.Height)),
+			}
+			gw, gh := float64(g.cols)*cw, float64(g.rows)*ch
+			iw, ih := float64(info.Width), float64(info.Height)
+			scale := math.Min(gw/iw, gh/ih)
+			dw, dh := iw*scale, ih*scale
+			left := float64(x-c)*cw + (gw-dw)/2
+			top := float64(y-r)*ch + (gh-dh)/2
+			destination := image.Rect(
+				int(math.Round(left)), int(math.Round(top)),
+				int(math.Round(left+dw)), int(math.Round(top+dh)),
+			)
+			cellRect := image.Rect(x*b.cellWidth, y*b.cellHeight, (x+1)*b.cellWidth, (y+1)*b.cellHeight)
+			clip, ok := target.SubImage(cellRect).(*image.RGBA)
+			if !ok {
+				continue
+			}
+			xdraw.ApproxBiLinear.Scale(clip, destination, source, source.Bounds(), draw.Over, nil)
+		}
+	}
+	return nil
+}
+
+// kittyDiacriticIndex is a row or column number from the Kitty protocol's
+// rowcolumn-diacritics table, or -1 for any other rune.
+func kittyDiacriticIndex(r rune) int {
+	i := sort.Search(len(kittyDiacritics), func(i int) bool { return kittyDiacritics[i] >= r })
+	if i < len(kittyDiacritics) && kittyDiacritics[i] == r {
+		return i
+	}
+	return -1
+}
