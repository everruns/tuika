{
  "name": "tuika-site",
  "version": "0.0.1",
  "packageManager": "pnpm@10.34.5",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:docs": "node scripts/sync-docs.mjs",
    "predev": "pnpm run sync:docs",
    "dev": "astro dev",
    "prebuild": "pnpm run sync:docs",
    "build": "astro build",
    "postbuild": "node scripts/normalize-sitemap.mjs && node scripts/verify-site.mjs",
    "preview": "astro preview",
    "pretypecheck": "pnpm run sync:docs",
    "typecheck": "astro check",
    "test": "node --test src/worker.test.js",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "prepreview:cf": "astro build",
    "preview:cf": "wrangler dev",
    "predeploy": "astro check && pnpm build",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "^0.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@iconify-json/ph": "^1.2.2",
    "astro": "^7.4.2",
    "astro-icon": "^1.2.0",
    "astro-og-canvas": "^0.13.2",
    "canvaskit-wasm": "^0.41.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri@>=3.0.0 <3.1.6": "3.1.8",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "svgo@>=4.0.0 <4.1.0": "4.1.0",
      "sharp@>=0.35.0 <0.35.5": "0.35.5"
    }
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
